<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppMonoFontFamily">Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#252526" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#B8111111" />
                    <SolidColorBrush x:Key="AppOverlayBorderBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="AppOverlayTextBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppOverlayMutedTextBrush" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="AppStatusAccentBrush" Color="#00E676" />
                    <SolidColorBrush x:Key="AppWarningAccentBrush" Color="#E0A84C" />
                    <SolidColorBrush x:Key="AppLinkAccentBrush" Color="#4EA1FF" />
                    <SolidColorBrush x:Key="AppLinkBorderBrush" Color="#554EA1FF" />
                    <SolidColorBrush x:Key="AppLinkHoverBackgroundBrush" Color="#224EA1FF" />
                    <SolidColorBrush x:Key="AppBadgeBackgroundBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="AppBadgeBorderBrush" Color="#46464A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#252526" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#B8111111" />
                    <SolidColorBrush x:Key="AppOverlayBorderBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="AppOverlayTextBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppOverlayMutedTextBrush" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="AppStatusAccentBrush" Color="#00E676" />
                    <SolidColorBrush x:Key="AppWarningAccentBrush" Color="#E0A84C" />
                    <SolidColorBrush x:Key="AppLinkAccentBrush" Color="#4EA1FF" />
                    <SolidColorBrush x:Key="AppLinkBorderBrush" Color="#554EA1FF" />
                    <SolidColorBrush x:Key="AppLinkHoverBackgroundBrush" Color="#224EA1FF" />
                    <SolidColorBrush x:Key="AppBadgeBackgroundBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="AppBadgeBorderBrush" Color="#46464A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#D6DBE2" />
                    <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppOverlayBackgroundBrush" Color="#CC1A1D24" />
                    <SolidColorBrush x:Key="AppOverlayBorderBrush" Color="#44FFFFFF" />
                    <SolidColorBrush x:Key="AppOverlayTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppOverlayMutedTextBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="AppStatusAccentBrush" Color="#0F8A4B" />
                    <SolidColorBrush x:Key="AppWarningAccentBrush" Color="#A86400" />
                    <SolidColorBrush x:Key="AppLinkAccentBrush" Color="#0E63C9" />
                    <SolidColorBrush x:Key="AppLinkBorderBrush" Color="#550E63C9" />
                    <SolidColorBrush x:Key="AppLinkHoverBackgroundBrush" Color="#180E63C9" />
                    <SolidColorBrush x:Key="AppBadgeBackgroundBrush" Color="#ECEFF4" />
                    <SolidColorBrush x:Key="AppBadgeBorderBrush" Color="#CFD6E0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Shared surface containers -->
    <Style Selector="Border.media-card">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #40000000" />
    </Style>

    <Style Selector="Border.inspector-card">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="Border.overlay-panel">
        <Setter Property="Background" Value="{DynamicResource AppOverlayBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppOverlayBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="10" />
    </Style>

    <Style Selector="Border.badge-chip">
        <Setter Property="Background" Value="{DynamicResource AppBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Shared playback & inspector buttons -->
    <Style Selector="Button.transport-btn">
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.toolbar-btn">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.pptr-link">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppLinkAccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppLinkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.pptr-link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppLinkHoverBackgroundBrush}" />
    </Style>

    <!-- Shared typography -->
    <Style Selector="TextBlock.media-title">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.status-label">
        <Setter Property="Foreground" Value="{DynamicResource AppStatusAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.mono-counter">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.overlay-counter">
        <Setter Property="Foreground" Value="{DynamicResource AppOverlayTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
