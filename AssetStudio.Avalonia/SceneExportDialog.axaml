<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetStudio.Avalonia.ViewModels"
        x:Class="AssetStudio.Avalonia.SceneExportDialog"
        x:CompileBindings="True"
        x:DataType="vm:SceneExportDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="660"
        Height="640"
        MinWidth="520"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14" RowSpacing="10">
        <!-- Header Banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10">
            <StackPanel Spacing="4">
                <TextBlock Text="Select Unity Scene(s) to Export"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBlock Text="Check one or more scenes (including additive sub-scenes). Cross-bundle dependencies, sharedassets pairs, and Addressables meshes/materials are resolved automatically."
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Search & Selection Controls -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0"
                     PlaceholderText="Filter scenes by name, path, file, or source..."
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Grid.Column="1"
                    Content="Clear"
                    Command="{Binding ClearSearchCommand}" />
            <Button Grid.Column="2"
                    Content="Select Visible"
                    Command="{Binding SelectAllFilteredCommand}" />
            <Button Grid.Column="3"
                    Content="Clear Selection"
                    Command="{Binding ClearSelectionCommand}" />
        </Grid>

        <!-- Scene List -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredScenes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneSelectionItemViewModel" x:CompileBindings="True">
                                <Border Padding="8,6"
                                        Margin="0,0,0,2"
                                        CornerRadius="4"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding BuildIndexDisplay}"
                                                           IsVisible="{Binding HasBuildIndex}"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                                                           Foreground="{DynamicResource SystemAccentColor}" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubtitleDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Padding="6,2"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                            <TextBlock Text="{Binding SourceKind}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No scenes match the current filter."
                           IsVisible="{Binding HasNoFilteredScenes}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </Grid>
        </Border>

        <!-- Smart Export Options -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Scene Export Options"
                           FontWeight="SemiBold" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="LOD Mode"
                               Width="110"
                               VerticalAlignment="Center" />
                    <ComboBox Width="240"
                              ItemsSource="{Binding LodModeOptions}"
                              SelectedIndex="{Binding SelectedLodModeIndex, Mode=TwoWay}" />
                </StackPanel>

                <CheckBox Content="Include inactive objects"
                          IsChecked="{Binding IncludeInactive, Mode=TwoWay}" />
                <CheckBox Content="Export cameras &amp; lights (glTF)"
                          IsChecked="{Binding ExportCamerasAndLights, Mode=TwoWay}" />
                <CheckBox Content="Resolve static script spawns (opt-in)"
                          IsChecked="{Binding ResolveStaticScriptSpawns, Mode=TwoWay}"
                          ToolTip.Tip="Inspects scene MonoBehaviours for statically assigned prefab PPtrs and Addressables GUIDs, attaching resolved prefabs and logging dynamic spawner hints in the manifest." />
                <CheckBox Content="Write reconstruction manifest (.manifest.json)"
                          IsChecked="{Binding WriteManifest, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- Footer Summary & Buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectionSummaryText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Export..."
                        MinWidth="92"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
                <Button Content="Cancel"
                        MinWidth="84"
                        IsCancel="True"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
