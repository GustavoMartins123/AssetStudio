<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:AssetStudio.Avalonia"
        xmlns:vm="using:AssetStudio.Avalonia.ViewModels"
        xmlns:svc="using:AssetStudio.Avalonia.Services"
        xmlns:ffmpeg="using:AssetStudio.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1264" d:DesignHeight="681"
        x:Class="AssetStudio.Avalonia.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ProjectSession.WindowTitle}"
        Icon="/Assets/as.png"
        Width="1264" Height="681"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenProjectManagerCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <Menu Grid.Column="0">
                <MenuItem Header="_File">
                    <MenuItem Header="Load file" Command="{Binding LoadFileCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource icon_file}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Load folder" Command="{Binding LoadFolderCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource icon_folder}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Load folder (Full / Scene Hierarchy)" Command="{Binding LoadFolderEagerCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource icon_folder}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Extract file" Command="{Binding ExtractFileCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource icon_extract}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Extract folder" Command="{Binding ExtractFolderCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource icon_extract}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="backToProjectsMenuItem"
                              Header="Back to _Projects..."
                              InputGesture="Ctrl+Shift+P"
                              Command="{Binding OpenProjectManagerCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource icon_folder}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem x:Name="displayAll" Header="Display all assets" ToggleType="CheckBox" IsChecked="{Binding Options.DisplayAll, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_eye}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="enablePreview" Header="Enable preview" ToggleType="CheckBox" IsChecked="{Binding Options.EnablePreview, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_preview}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="displayInfo" Header="Display asset information" ToggleType="CheckBox" IsChecked="{Binding Options.DisplayInfo, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_info}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="useDiskDecompressionCacheMenu" Header="Use disk decompression cache (Lazy Mode)" ToggleType="CheckBox" IsChecked="{Binding Options.UseDiskDecompressionCache, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="autoLoadCatalogDependenciesMenu" Header="Auto-load Addressables catalog dependencies" ToggleType="CheckBox" IsChecked="{Binding Options.AutoLoadCatalogDependencies, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="autoLoadExternalDependenciesMenu" Header="Auto-load .assets external dependencies (cascade)" ToggleType="CheckBox" IsChecked="{Binding Options.AutoLoadExternalDependencies, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set project root..." Command="{Binding SetProjectRootCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_folder}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Decryption keys &amp; plugins..." Command="{Binding OpenDecryptionSettingsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Specify Unity version">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                    <TextBox x:Name="SpecifyUnityVersionTextBox" Width="140" PlaceholderText="2020.3.48f1" Text="{Binding Options.SpecifyUnityVersion, Mode=TwoWay}" />
                </MenuItem>
                <MenuItem Header="Export options" Command="{Binding ShowExportOptionsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Clear project cache" Command="{Binding ClearProjectCacheCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_settings}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Theme">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_theme}" Width="16" Height="16" />
                    </MenuItem.Icon>
                    <MenuItem x:Name="themeDefault" Header="System Default" ToggleType="Radio" GroupName="ThemeGroup" IsChecked="{Binding Options.IsThemeDefault, Mode=TwoWay}" Command="{Binding Options.SetThemeDefaultCommand}" />
                    <MenuItem x:Name="themeLight" Header="Light" ToggleType="Radio" GroupName="ThemeGroup" IsChecked="{Binding Options.IsThemeLight, Mode=TwoWay}" Command="{Binding Options.SetThemeLightCommand}" />
                    <MenuItem x:Name="themeDark" Header="Dark" ToggleType="Radio" GroupName="ThemeGroup" IsChecked="{Binding Options.IsThemeDark, Mode=TwoWay}" Command="{Binding Options.SetThemeDarkCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Model">
                <MenuItem Header="Export all objects (split)" Command="{Binding ExportAllObjectsSplitCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export selected objects (split)" Command="{Binding ExportSelectedObjectsSplitCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export selected objects (split) + selected AnimationClips" Command="{Binding ExportSelectedObjectsSplitWithAnimationClipCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Export selected objects (merge)" Command="{Binding ExportSelectedObjectsMergeCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export selected objects (merge) + selected AnimationClips" Command="{Binding ExportSelectedObjectsMergeWithAnimationClipCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="exportSceneGlbMenuItem" Header="Export Scene to .glb (Instanced)..." Command="{Binding ExportSceneGlbCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="exportSelectedSubtreeGlbMenuItem" Header="Export Selected Subtree to .glb (Instanced)..." Command="{Binding ExportSelectedSubtreeGlbCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="All assets" Command="{Binding ExportAllAssetsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_export}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Selected assets" Command="{Binding ExportSelectedAssetsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_export}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Filtered assets" Command="{Binding ExportFilteredAssetsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_export}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Export Model Group..." Command="{Binding ExportModelGroupFbxCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Model / Animator + selected AnimationClips" Command="{Binding ExportAnimatorWithSelectedAnimationClipCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_export}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Raw">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_cube}" Width="16" Height="16" />
                    </MenuItem.Icon>
                    <MenuItem Header="All assets" Command="{Binding ExportAllAssetsRawCommand}" />
                    <MenuItem Header="Selected assets" Command="{Binding ExportSelectedAssetsRawCommand}" />
                    <MenuItem Header="Filtered assets" Command="{Binding ExportFilteredAssetsRawCommand}" />
                </MenuItem>
                <MenuItem Header="Dump">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_file}" Width="16" Height="16" />
                    </MenuItem.Icon>
                    <MenuItem Header="All assets" Command="{Binding ExportAllAssetsDumpCommand}" />
                    <MenuItem Header="Selected assets" Command="{Binding ExportSelectedAssetsDumpCommand}" />
                    <MenuItem Header="Filtered assets" Command="{Binding ExportFilteredAssetsDumpCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Asset list to XML">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_file}" Width="16" Height="16" />
                    </MenuItem.Icon>
                    <MenuItem Header="All assets" Command="{Binding ExportAllAssetsXmlCommand}" />
                    <MenuItem Header="Selected assets" Command="{Binding ExportSelectedAssetsXmlCommand}" />
                    <MenuItem Header="Filtered assets" Command="{Binding ExportFilteredAssetsXmlCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Error log" Command="{Binding ExportErrorLogCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_info}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="filterTypeMenu" Header="Filter _Type">
                <MenuItem x:Name="filterTypeAll" Header="All" ToggleType="CheckBox" IsChecked="True" Command="{Binding FilterTypeAllCommand}" />
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem x:Name="showErrorMessageMenu" Header="Show error message" ToggleType="CheckBox" IsChecked="{Binding Options.ShowErrorMessage, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_debug}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="exportClassStructuresMenu" Header="Export class structures" Command="{Binding ExportClassStructuresCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource icon_debug}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="indexingMenu" Header="_Indexing" IsVisible="{Binding IsIndexingActive}">
                <MenuItem x:Name="pauseIndexingMenu" Header="Pause Indexing" Command="{Binding PauseIndexingCommand}" />
                <MenuItem x:Name="resumeIndexingMenu" Header="Resume Indexing" Command="{Binding ResumeIndexingCommand}" />
                <MenuItem x:Name="stopIndexingMenu" Header="Stop/Cancel Indexing" Command="{Binding StopIndexingCommand}" />
            </MenuItem>
            </Menu>
            <Button x:Name="BackToProjectsButton"
                    Grid.Column="1"
                    Command="{Binding OpenProjectManagerCommand}"
                    VerticalAlignment="Center"
                    Margin="4,2,8,2"
                    Padding="10,3"
                    FontSize="12"
                    ToolTip.Tip="Close current project and return to Projects (Ctrl+Shift+P)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="←" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Projects" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="ProjectAnalysisBannerBorder"
                DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4"
                IsVisible="{Binding ProjectSession.HasRuntimeBanner}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="ProjectAnalysisBannerText"
                           Grid.Column="0"
                           Text="{Binding ProjectSession.RuntimeBannerText}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button x:Name="SetDecryptionKeyButton"
                        Grid.Column="1"
                        Content="Set Decryption Key..."
                        Command="{Binding OpenDecryptionSettingsCommand}"
                        IsVisible="{Binding ProjectSession.ShowDecryptionKeyButton}"
                        Padding="8,2"
                        FontSize="11"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*, Auto" Height="24" Margin="2,0">
            <ProgressBar x:Name="progressBar" Grid.Column="0" Height="20" Minimum="0" Maximum="100" Value="{Binding LoadingProgress}" />
            <TextBlock x:Name="statusLabel" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0" Text="{Binding StatusText}" />
        </Grid>

        <Grid ColumnDefinitions="7*, 5, 3*">
            
            <TabControl x:Name="LeftTabControl" Grid.Column="0" Margin="2">
                <TabItem Header="Scene Hierarchy">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,3" ColumnSpacing="4">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <ToggleButton x:Name="SceneHierarchyScenesModeButton"
                                              Content="Scenes"
                                              Height="24"
                                              Padding="8,1"
                                              FontSize="11"
                                              IsChecked="{Binding SceneHierarchy.IsScenesMode, Mode=TwoWay}"
                                              Command="{Binding SceneHierarchy.ShowScenesModeCommand}"
                                              ToolTip.Tip="Browse Unity scenes and GameObject hierarchies (loads scenes on demand in Lazy Mode)" />
                                <ToggleButton x:Name="SceneHierarchyContainersModeButton"
                                              Content="Containers"
                                              Height="24"
                                              Padding="8,1"
                                              FontSize="11"
                                              IsChecked="{Binding SceneHierarchy.IsContainersMode, Mode=TwoWay}"
                                              Command="{Binding SceneHierarchy.ShowContainersModeCommand}"
                                              ToolTip.Tip="Browse assets organized by Unity container path or bundle filename (zero disk I/O)" />
                            </StackPanel>
                            <TextBlock x:Name="SceneHierarchySummaryText"
                                       Grid.Column="1"
                                       Text="{Binding SceneHierarchy.ModeSummaryText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                            <Button x:Name="SceneHierarchyRefreshButton"
                                    Grid.Column="2"
                                    Classes="toolbar-btn"
                                    Height="24"
                                    Padding="6,1"
                                    Content="↻"
                                    Command="{Binding SceneHierarchy.RefreshCurrentModeCommand}"
                                    IsVisible="{Binding SceneHierarchy.CanRefresh}"
                                    ToolTip.Tip="Refresh Scene Hierarchy view" />
                        </Grid>

                        <TextBox x:Name="treeSearch"
                                 Grid.Row="1"
                                 PlaceholderText="{Binding SceneHierarchy.SearchPlaceholderText}"
                                 Margin="0,0,0,2"
                                 Text="{Binding SceneHierarchy.SearchQuery, Mode=TwoWay}"
                                 TextChanged="TreeSearch_TextChanged"
                                 KeyDown="TreeSearch_KeyDown"/>

                        <Panel Grid.Row="2">
                            <TreeView x:Name="SceneTreeView"
                                      IsVisible="{Binding SceneHierarchy.IsScenesMode}"
                                      ItemsSource="{Binding SceneHierarchy.Nodes}"
                                      AutoScrollToSelectedItem="True"
                                      SelectionChanged="SceneTreeView_SelectionChanged">
                                <TreeView.ContextMenu>
                                    <ContextMenu x:DataType="vm:MainWindowViewModel" x:CompileBindings="True">
                                        <MenuItem Header="Load Scene Hierarchy"
                                                  Command="{Binding SceneHierarchy.LoadSelectedSceneCommand}"
                                                  IsVisible="{Binding SceneHierarchy.CanLoadSelectedScene}" />
                                        <MenuItem Header="Export Selected Scene to .glb (Instanced)..."
                                                  Command="{Binding SceneHierarchy.ExportSelectedSceneGlbCommand}" />
                                        <MenuItem Header="Export Selected Subtree to .glb (Instanced)..."
                                                  Command="{Binding ExportSelectedSubtreeGlbCommand}" />
                                        <Separator />
                                        <MenuItem Header="Export Scene(s) Dialog..."
                                                  Command="{Binding ExportSceneGlbCommand}" />
                                        <MenuItem Header="Expand Loaded Subtree"
                                                  Command="{Binding SceneHierarchy.ExpandSelectedSubtreeCommand}" />
                                        <MenuItem Header="Collapse Subtree"
                                                  Command="{Binding SceneHierarchy.CollapseSelectedSubtreeCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem" x:DataType="local:GameObjectNode">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children, Mode=OneWay}" x:DataType="local:GameObjectNode" x:CompileBindings="True">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsVisible="{Binding ShowCheckBox, Mode=OneWay}"
                                                      Focusable="False"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                       Opacity="{Binding NodeTextOpacity, Mode=OneWay}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                       IsVisible="{Binding HasSubtitle, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <TreeView x:Name="ContainersTreeView"
                                      IsVisible="{Binding SceneHierarchy.IsContainersMode}"
                                      ItemsSource="{Binding SceneHierarchy.ContainerNodes}"
                                      AutoScrollToSelectedItem="True"
                                      SelectionChanged="ContainersTreeView_SelectionChanged">
                                <TreeView.ContextMenu>
                                    <ContextMenu x:DataType="vm:MainWindowViewModel" x:CompileBindings="True">
                                        <MenuItem Header="Show in Asset List"
                                                  Command="{Binding SceneHierarchy.ShowSelectedContainerInAssetListCommand}" />
                                        <MenuItem Header="Export Selected Asset..."
                                                  Command="{Binding SceneHierarchy.ExportSelectedContainerAssetCommand}" />
                                        <MenuItem Header="Copy Container Path"
                                                  Command="{Binding SceneHierarchy.CopySelectedContainerPathCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem" x:DataType="vm:ContainerTreeNode">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children, Mode=OneWay}" x:DataType="vm:ContainerTreeNode" x:CompileBindings="True">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NodeGlyph, Mode=OneTime}"
                                                       FontSize="11"
                                                       Opacity="{Binding NodeTextOpacity, Mode=OneWay}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name, Mode=OneTime}"
                                                       Opacity="{Binding NodeTextOpacity, Mode=OneWay}"
                                                       VerticalAlignment="Center" />
                                            <Border Classes="badge-chip"
                                                    IsVisible="{Binding HasTypeBadge, Mode=OneTime}">
                                                <TextBlock Text="{Binding TypeBadge, Mode=OneTime}"
                                                           FontSize="10"
                                                           Opacity="0.85"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                       IsVisible="{Binding HasSubtitle, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Panel>
                    </Grid>
                </TabItem>
                
                <TabItem Header="Asset List">
                    <Grid RowDefinitions="Auto, *">
                        <DockPanel Grid.Row="0" Margin="0,0,0,2">
                            <Button x:Name="ClearClassFilterButton"
                                    Content="{Binding AssetList.ClassFilterButtonText}"
                                    Command="{Binding ClearClassFilterCommand}"
                                    IsVisible="{Binding AssetList.HasClassFilterOverride}"
                                    DockPanel.Dock="Right"
                                    Margin="4,0,0,0"
                                    Padding="6,2"/>
                            <TextBox x:Name="listSearch" PlaceholderText=" Filter " Text="{Binding AssetList.SearchText, Mode=TwoWay}" TextChanged="ListSearch_TextChanged"/>
                        </DockPanel>
                        <DataGrid x:Name="AssetListDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" x:CompileBindings="True" x:DataType="local:AssetItem" SelectionChanged="AssetListDataGrid_SelectionChanged" CellPointerPressed="AssetListDataGrid_CellPointerPressed" Sorting="AssetListDataGrid_Sorting" CanUserResizeColumns="True" CanUserSortColumns="True" HorizontalScrollBarVisibility="Auto" SelectionMode="Extended">
                            <DataGrid.ContextMenu>
                                <ContextMenu x:DataType="vm:MainWindowViewModel" Opened="AssetListContextMenu_Opened">
                                    <MenuItem Header="Copy text" Command="{Binding CopyAssetCellTextCommand}" />
                                    <MenuItem Header="Export selected assets" Command="{Binding ExportSelectedAssetsCommand}" />
                                    <MenuItem x:Name="exportModelGroupFbxMenuItem" Header="Export Model Group..." Command="{Binding ExportModelGroupFbxCommand}" />
                                    <MenuItem x:Name="exportAnimatorWithSelectedAnimationClipMenuItem" Header="Export Model / Animator + selected AnimationClips" Command="{Binding ExportAnimatorWithSelectedAnimationClipCommand}" />
                                    <MenuItem x:Name="goToSceneHierarchyMenuItem" Header="Go to scene hierarchy" Command="{Binding GoToSceneHierarchyCommand}" />
                                    <MenuItem x:Name="showOriginalFileMenuItem" Header="Show original file" Command="{Binding ShowOriginalFileCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="220" MinWidth="90" />
                                <DataGridTextColumn Header="Container" Binding="{Binding Container}" SortMemberPath="Container" Width="220" MinWidth="90" />
                                <DataGridTextColumn Header="Type" Binding="{Binding DisplayType}" SortMemberPath="DisplayType" Width="130" MinWidth="80" />
                                <DataGridTextColumn Header="PathID" Binding="{Binding PathID}" SortMemberPath="PathID" Width="210" MinWidth="120" />
                                <DataGridTextColumn Header="Size" Binding="{Binding FullSize}" SortMemberPath="FullSize" Width="90" MinWidth="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Asset Classes">
                    <Grid RowDefinitions="Auto, *">
                        <TextBox x:Name="classSearch" Grid.Row="0" PlaceholderText=" Filter classes " Margin="0,0,0,2" Text="{Binding AssetList.ClassSearchText, Mode=TwoWay}" TextChanged="ClassSearch_TextChanged" />
                        <DataGrid x:Name="AssetClassesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" x:CompileBindings="True" x:DataType="local:AssetClassItem" SelectionChanged="AssetClassesDataGrid_SelectionChanged" CanUserResizeColumns="True" CanUserSortColumns="True" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu x:DataType="vm:MainWindowViewModel">
                                    <MenuItem Header="Show instances in Asset List" Command="{Binding ShowClassInstancesCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ClassID}" SortMemberPath="ClassID" Width="70" MinWidth="55" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="180" MinWidth="90" />
                                <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" SortMemberPath="Namespace" Width="150" MinWidth="80" />
                                <DataGridTextColumn Header="Assembly" Binding="{Binding Assembly}" SortMemberPath="Assembly" Width="160" MinWidth="90" />
                                <DataGridTextColumn Header="Unity" Binding="{Binding UnityVersion}" SortMemberPath="UnityVersion" Width="110" MinWidth="80" />
                                <DataGridTextColumn Header="Objects" Binding="{Binding ObjectCount}" SortMemberPath="ObjectCount" Width="80" MinWidth="65" />
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" SortMemberPath="SourceKind" Width="130" MinWidth="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Background="{DynamicResource SystemControlBorderBackgroundBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="2">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="NavigateBackButton"
                                Content="←"
                                Width="28"
                                Height="26"
                                Padding="0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding NavigateBackCommand}"
                                ToolTip.Tip="{Binding PreviewSession.NavigateBackTooltip}" />
                        <Button x:Name="NavigateForwardButton"
                                Content="→"
                                Width="28"
                                Height="26"
                                Padding="0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding NavigateForwardCommand}"
                                ToolTip.Tip="{Binding PreviewSession.NavigateForwardTooltip}" />
                    </StackPanel>
                    <TabStrip x:Name="RightTabControl" Grid.Column="1" SelectedIndex="0" SelectionChanged="RightTabControl_SelectionChanged">
                        <TabStripItem Content="Preview" />
                        <TabStripItem Content="Dump" />
                        <TabStripItem Content="References" />
                        <TabStripItem Content="Script" />
                    </TabStrip>
                </Grid>

                <Panel Grid.Row="1">
                    <!-- Persistent Preview container: stays attached to the visual tree across Preview/Dump tab switches so OpenGlControlBase surfaces never tear down. -->
                    <Grid x:Name="PreviewTabContent" RowDefinitions="Auto,*" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" IsVisible="{Binding PreviewSession.IsPreviewTabActive}">
                        <Border x:Name="IndexingProgressPanel" Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}" BorderThickness="0,0,0,1" Padding="10,7" IsVisible="{Binding IndexingProgress.IsPanelVisible}">
                            <Grid RowDefinitions="Auto,4" ColumnDefinitions="*,Auto" RowSpacing="5" ColumnSpacing="12">
                                <TextBlock x:Name="IndexingProgressText" Text="{Binding IndexingProgress.PrimaryStatusText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock x:Name="IndexingProgressPercentText" Grid.Column="1" Text="{Binding IndexingProgress.FormattedPercentText}" FontSize="12" FontFamily="Monospace" Opacity="0.82" VerticalAlignment="Center" />
                                <ProgressBar x:Name="IndexingProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding IndexingProgress.ProgressPercent}" Height="4" />
                            </Grid>
                        </Border>

                        <Panel x:Name="PreviewContentHost" Grid.Row="1" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
                        <TextBox x:Name="TextPreviewBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" IsVisible="False" />
                        <Border x:Name="TextAssetPreviewPanel" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding PreviewSession.HasDialoguePreview}">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="TextAssetPreviewTitle" Text="{Binding PreviewSession.PreviewTitle}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TextAssetPreviewSubtitle" Text="{Binding PreviewSession.PreviewSubtitle}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button x:Name="TextAssetCardsViewButton" Content="Cards" MinWidth="64" Height="28" Padding="10,4" HorizontalContentAlignment="Center" Command="{Binding ShowTextAssetCardsCommand}" />
                                            <Button x:Name="TextAssetDetailsViewButton" Content="Text" MinWidth="64" Height="28" Padding="10,4" HorizontalContentAlignment="Center" Command="{Binding ShowTextAssetDetailsCommand}" />
                                            <Button x:Name="TextAssetInfoViewButton" Content="Info" MinWidth="64" Height="28" Padding="10,4" HorizontalContentAlignment="Center" Command="{Binding ShowTextAssetInfoCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="TextAssetDialogueCardsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="16"
                                             IsVisible="{Binding PreviewSession.IsDialogueCardsVisible}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0,0,0,10" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:TextAssetDialogueCardViewModel" x:CompileBindings="True">
                                                <Border Background="{Binding CardBackground, Mode=OneTime}"
                                                        BorderBrush="{Binding CardBorderBrush, Mode=OneTime}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12"
                                                        MaxWidth="820"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Title, Mode=OneTime}"
                                                                       Foreground="{Binding TitleForeground, Mode=OneTime}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding OffsetText, Mode=OneTime}"
                                                                       Foreground="{Binding MetadataForeground, Mode=OneTime}"
                                                                       FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                                                                       FontSize="11"
                                                                       Margin="12,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding BodyText, Mode=OneTime}"
                                                                   Foreground="{Binding BodyForeground, Mode=OneTime}"
                                                                   FontSize="16"
                                                                   LineHeight="23"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding FooterText, Mode=OneTime}"
                                                                   Foreground="{Binding FooterForeground, Mode=OneTime}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBox x:Name="TextAssetDetailsTextBox"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             Text="{Binding PreviewSession.TextContent, Mode=OneWay}"
                                             IsVisible="{Binding PreviewSession.IsDialogueDetailsVisible}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Phase 1: MonoBehaviour / ScriptableObject Searchable Tree + JSON Viewer -->
                        <Border x:Name="MonoBehaviourPreviewPanel"
                                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding PreviewSession.IsMonoBehaviourPanelVisible}">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                        BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="MonoBehaviourScriptTitleText"
                                                       Text="{Binding PreviewSession.MonoBehaviourScriptTitle}"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="MonoBehaviourSummaryText"
                                                       Text="{Binding PreviewSession.MonoBehaviourSummaryText}"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="MonoBehaviourTreeModeButton"
                                                    Classes="toolbar-btn"
                                                    Content="Tree"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding ShowMonoBehaviourTreeCommand}" />
                                            <Button x:Name="MonoBehaviourJsonModeButton"
                                                    Classes="toolbar-btn"
                                                    Content="JSON"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding ShowMonoBehaviourJsonCommand}" />
                                            <Button x:Name="MonoBehaviourExpandAllButton"
                                                    Classes="toolbar-btn"
                                                    Content="Expand"
                                                    Margin="0,0,4,0"
                                                    IsVisible="{Binding PreviewSession.IsMonoBehaviourTreeViewVisible}"
                                                    Command="{Binding ExpandAllMonoBehaviourCommand}" />
                                            <Button x:Name="MonoBehaviourCollapseAllButton"
                                                    Classes="toolbar-btn"
                                                    Content="Collapse"
                                                    Margin="0,0,4,0"
                                                    IsVisible="{Binding PreviewSession.IsMonoBehaviourTreeViewVisible}"
                                                    Command="{Binding CollapseAllMonoBehaviourCommand}" />
                                            <Button x:Name="MonoBehaviourCopyJsonButton"
                                                    Classes="toolbar-btn"
                                                    Content="Copy JSON"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding CopyMonoBehaviourJsonCommand}" />
                                            <Button x:Name="MonoBehaviourViewScriptButton"
                                                    Classes="toolbar-btn"
                                                    Content="View C#"
                                                    Command="{Binding ViewSelectedScriptCommand}"
                                                    ToolTip.Tip="Open the reconstructed C# class source in the Script tab" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="MonoBehaviourFilterTextBox"
                                         Grid.Row="1"
                                         Margin="8,6,8,4"
                                         PlaceholderText="Filter fields, values, types, or PPtr targets..."
                                         IsVisible="{Binding PreviewSession.IsMonoBehaviourTreeViewVisible}"
                                         Text="{Binding PreviewSession.MonoBehaviourFilterText, Mode=TwoWay}" />
                                <Grid Grid.Row="2">
                                    <TreeView x:Name="MonoBehaviourTreeView"
                                              Margin="4,0,4,4"
                                              IsVisible="{Binding PreviewSession.IsMonoBehaviourTreeViewVisible}"
                                              ItemsSource="{Binding PreviewSession.MonoBehaviourTreeRoots}">
                                        <TreeView.Styles>
                                            <Style Selector="TreeViewItem" x:DataType="svc:AssetPropertyNode">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            </Style>
                                        </TreeView.Styles>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children, Mode=OneTime}" x:DataType="svc:AssetPropertyNode" x:CompileBindings="True">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Mode=OneTime}"
                                                               FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <Border Classes="badge-chip"
                                                            IsVisible="{Binding HasTypeHint, Mode=OneTime}">
                                                        <TextBlock Text="{Binding TypeHint, Mode=OneTime}"
                                                                   FontSize="10"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ValueText, Mode=OneTime}"
                                                               FontFamily="{StaticResource AppMonoFontFamily}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding HasScalarOrSummaryValue, Mode=OneTime}" />
                                                    <Button Classes="pptr-link"
                                                            Content="{Binding PPtrDisplayLabel, Mode=OneTime}"
                                                            ToolTip.Tip="{Binding PPtrTooltip, Mode=OneTime}"
                                                            IsVisible="{Binding IsPPtr, Mode=OneTime}"
                                                            IsEnabled="{Binding IsNavigablePPtr, Mode=OneTime}"
                                                            Command="{Binding $parent[local:MainWindow].ViewModel.NavigateToPPtrCommand}"
                                                            CommandParameter="{Binding PPtrTarget, Mode=OneTime}" />
                                                </StackPanel>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <TextBox x:Name="MonoBehaviourJsonTextBox"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                                             FontSize="12"
                                             IsVisible="{Binding PreviewSession.IsMonoBehaviourJsonViewVisible}"
                                             Text="{Binding PreviewSession.MonoBehaviourJsonText, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Phase 1: Scene Hierarchy GameObject Component Inspector -->
                        <Border x:Name="GameObjectInspectorPanel"
                                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding PreviewSession.IsGameObjectInspectorVisible}">
                            <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
                                <Border Grid.Row="0" Classes="inspector-card">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock x:Name="InspectorGameObjectNameText"
                                                           Text="{Binding PreviewSession.InspectedGameObject.Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Classes="badge-chip">
                                                    <TextBlock Text="{Binding PreviewSession.InspectedGameObject.ActiveStateText}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="toolbar-btn"
                                                        Content="Export .glb"
                                                        ToolTip.Tip="Export this GameObject subtree to .glb with mesh instancing"
                                                        Command="{Binding ExportSelectedSubtreeGlbCommand}" />
                                                <Button Classes="toolbar-btn"
                                                        Content="Open Asset"
                                                        IsVisible="{Binding PreviewSession.InspectedGameObject.HasGameObjectTarget}"
                                                        Command="{Binding NavigateToInspectorTargetCommand}"
                                                        CommandParameter="{Binding PreviewSession.InspectedGameObject.GameObjectTarget}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding PreviewSession.InspectedGameObject.HierarchyPath}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding PreviewSession.InspectedGameObject.HasHierarchyPath}" />
                                        <TextBlock Text="{Binding PreviewSession.InspectedGameObject.HeaderMetadataLine}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   Opacity="0.82"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PreviewSession.InspectedGameObject.LazyNoticeText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppWarningAccentBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding PreviewSession.InspectedGameObject.HasLazyNotice}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <Border Classes="inspector-card"
                                            IsVisible="{Binding PreviewSession.InspectedGameObject.Transform.HasTransform}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding PreviewSession.InspectedGameObject.Transform.HeaderTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" FontSize="11" Opacity="0.75" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewSession.InspectedGameObject.Transform.PositionText}" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation" FontSize="11" Opacity="0.75" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewSession.InspectedGameObject.Transform.RotationEulerText}" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale" FontSize="11" Opacity="0.75" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewSession.InspectedGameObject.Transform.ScaleText}" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hierarchy" FontSize="11" Opacity="0.75" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PreviewSession.InspectedGameObject.Transform.ChildCount, StringFormat='Children: {0}'}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="• Parent:" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PreviewSession.InspectedGameObject.Transform.ParentName}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding !PreviewSession.InspectedGameObject.Transform.HasParentTarget}" />
                                                    <Button Classes="pptr-link"
                                                            Content="{Binding PreviewSession.InspectedGameObject.Transform.ParentName}"
                                                            IsVisible="{Binding PreviewSession.InspectedGameObject.Transform.HasParentTarget}"
                                                            Command="{Binding NavigateToInspectorTargetCommand}"
                                                            CommandParameter="{Binding PreviewSession.InspectedGameObject.Transform.ParentTarget}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding PreviewSession.InspectedGameObject.Transform.RectSummaryText}"
                                                       FontFamily="{StaticResource AppMonoFontFamily}"
                                                       FontSize="10"
                                                       Opacity="0.82"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding PreviewSession.InspectedGameObject.Transform.HasRectSummary}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PreviewSession.InspectorComponentsHeader}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox x:Name="InspectorFilterTextBox"
                                             PlaceholderText="Filter components or linked assets..."
                                             Text="{Binding PreviewSession.InspectorFilterText, Mode=TwoWay}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="InspectorComponentsList" ItemsSource="{Binding PreviewSession.InspectorComponents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:GameObjectComponentInfo" x:CompileBindings="True">
                                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                        BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="9,7"
                                                        Margin="0,0,0,6">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <StackPanel Grid.Column="0" Spacing="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding DisplayTitle, Mode=OneTime}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Border Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                                                            BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Padding="4,0"
                                                                            IsVisible="{Binding HasEnabledBadge, Mode=OneTime}">
                                                                        <TextBlock Text="{Binding EnabledBadge, Mode=OneTime}"
                                                                                   FontSize="10"
                                                                                   Opacity="0.85" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Subtitle, Mode=OneTime}"
                                                                           FontSize="10"
                                                                           Opacity="0.72"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding HasSubtitle, Mode=OneTime}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="Inspect →"
                                                                    Height="22"
                                                                    Padding="7,1"
                                                                    FontSize="11"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding HasComponentTarget, Mode=OneTime}"
                                                                    Command="{Binding $parent[local:MainWindow].ViewModel.NavigateToInspectorTargetCommand}"
                                                                    CommandParameter="{Binding ComponentTarget, Mode=OneTime}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Summary, Mode=OneTime}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding HasSummary, Mode=OneTime}" />
                                                        <ItemsControl ItemsSource="{Binding LinkedAssets, Mode=OneTime}"
                                                                      IsVisible="{Binding HasLinkedAssets, Mode=OneTime}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="svc:AssetReferenceItem" x:CompileBindings="True">
                                                                    <Button Classes="pptr-link"
                                                                            Margin="0,2,4,2"
                                                                            ToolTip.Tip="{Binding DetailLine, Mode=OneTime}"
                                                                            IsEnabled="{Binding IsNavigable, Mode=OneTime}"
                                                                            Command="{Binding $parent[local:MainWindow].ViewModel.NavigateToInspectorTargetCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <TextBlock Text="{Binding Relation, StringFormat='{}{0}:', Mode=OneTime}" Opacity="0.75" />
                                                                            <TextBlock Text="{Binding Name, Mode=OneTime}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewLabel" Text="[Preview Panel]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Image x:Name="ImagePreviewBox" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" />
                        <local:MeshPreviewControl x:Name="GLPreviewControl" IsVisible="False" Focusable="True"
                                                  IsMaterialShaderPreview="{Binding PreviewSession.ShaderPreview.IsActive}"
                                                  MaterialShaderFrame="{Binding PreviewSession.ShaderPreview.Frame}" />
                        <local:TextureGLPreviewControl x:Name="TextureGLPreview" IsVisible="False" Focusable="True" />
                        <Border x:Name="PreviewInfoBorder" Classes="overlay-panel" Width="300" MaxHeight="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding PreviewSession.IsInfoOverlayVisible}">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,4,8,4">
                                    <TextBlock Text="Preview Information" VerticalAlignment="Center" Foreground="{DynamicResource AppOverlayMutedTextBrush}" FontWeight="Bold" FontSize="11" />
                                    <Button Grid.Column="1" x:Name="TogglePreviewInfoBtn" Content="{Binding PreviewSession.InfoToggleGlyph}" Width="24" Height="24" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="Transparent" Foreground="{DynamicResource AppOverlayTextBrush}" BorderBrush="Transparent" Command="{Binding TogglePreviewInfoCommand}" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" x:Name="PreviewInfoScroll" IsVisible="{Binding PreviewSession.IsInfoExpanded}" MaxHeight="450" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PreviewInfoOverlay" Text="{Binding PreviewSession.PreviewMetadataSummary}" Foreground="{DynamicResource AppOverlayTextBrush}" FontFamily="{StaticResource AppMonoFontFamily}" FontSize="11" LineHeight="15" Margin="8,0,8,8" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="AnimationPlaybackPanel" Classes="overlay-panel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="10,8" MinWidth="320" IsVisible="{Binding MeshPreview.IsAnimationLoaded}">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Slider x:Name="AnimationProgressBar" Minimum="0" Maximum="1" Value="0" Focusable="False" Height="26" VerticalAlignment="Center" ValueChanged="AnimationProgressBar_ValueChanged" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="AnimFrameLabel" Classes="overlay-counter" Text="{Binding MeshPreview.FormattedFrameText}" />
                                        <TextBlock x:Name="AnimTimeLabel" Classes="overlay-counter" Opacity="0.85" Text="{Binding MeshPreview.FormattedTimeText}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AnimPlayPauseBtn" Classes="transport-btn" Content="{Binding MeshPreview.PlayPauseButtonText}" Command="{Binding ToggleAnimationPlayPauseCommand}" />
                                    <Button x:Name="AnimStopBtn" Classes="transport-btn" Content="Stop" Command="{Binding StopAnimationCommand}" />
                                    <Button x:Name="AnimRestartBtn" Classes="transport-btn" Content="Replay" Command="{Binding RestartAnimationCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="VideoClipPanel" Classes="media-card" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding MediaPlayback.IsVideoActive}">
                            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="VideoTitleLabel" Classes="media-title" Text="{Binding MediaPlayback.MediaTitle}"/>
                                    <TextBlock x:Name="VideoStatusLabel" Grid.Column="1" Classes="status-label" Text="{Binding MediaPlayback.StatusText}"/>
                                </Grid>
                                
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock x:Name="VideoResolutionLabel" Text="Resolution: 0x0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12"/>
                                    <TextBlock x:Name="VideoFrameRateLabel" Text="Frame Rate: 0 FPS" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12"/>
                                    <TextBlock x:Name="VideoFormatLabel" Text="Format: Unknown" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12"/>
                                    <TextBlock x:Name="VideoAudioLabel" Text="Audio: Checking..." Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12"/>
                                    <TextBlock x:Name="VideoInfoLabel" Text="{Binding MediaPlayback.EffectiveInfoText}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <Border Grid.Row="2" Background="Black" CornerRadius="8" ClipToBounds="True" MinHeight="100">
                                    <Grid>
                                        <ffmpeg:VideoPlayerControl x:Name="FfmpegVideoPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowControls="False" ShowOpenButton="False" Volume="80" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,4">
                                    <Slider x:Name="VideoProgressBar" Minimum="0" Maximum="1000" Value="0" Focusable="False" Height="32"
                                            ValueChanged="VideoProgressBar_ValueChanged"/>
                                    <TextBlock x:Name="VideoTimerLabel" Grid.Column="1" Classes="mono-counter" Text="{Binding MediaPlayback.FormattedTimeRange}" Margin="8,0,0,0"/>
                                </Grid>
                                
                                <WrapPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="VideoPlayButton" Classes="transport-btn" Content="{Binding MediaPlayback.PlayPauseButtonText}" Command="{Binding VideoPlayPauseCommand}" Margin="0,0,8,4"/>
                                    <Button x:Name="VideoStopButton" Classes="transport-btn" Content="Stop" Command="{Binding VideoStopCommand}" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="VideoLoopButton" Content="Loop" IsChecked="{Binding MediaPlayback.IsLooping, Mode=TwoWay}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center" Margin="0,0,16,4"/>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                                        <TextBlock Text="Vol" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                        <Slider x:Name="VideoVolumeBar" Minimum="0" Maximum="100" Value="80" Width="80" Focusable="False" VerticalAlignment="Center" ValueChanged="VideoVolumeBar_ValueChanged"/>
                                    </StackPanel>
                                    <Button x:Name="VideoExportButton" Classes="transport-btn" Content="Export" Command="{Binding VideoExportCommand}" MinWidth="70" Margin="0,0,0,4"/>
                                </WrapPanel>
                            </Grid>
                        </Border>


                        <Border x:Name="AudioPanel" Classes="media-card" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="460" IsVisible="{Binding MediaPlayback.IsAudioActive}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="AudioTitleLabel" Classes="media-title" Text="{Binding MediaPlayback.MediaTitle}"/>
                                    <TextBlock x:Name="AudioStatusLabel" Grid.Column="1" Classes="status-label" Text="{Binding MediaPlayback.StatusText}"/>
                                </Grid>
                                
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="AudioInfoLabel" Text="{Binding MediaPlayback.MediaInfoText}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AudioTimerLabel" Grid.Column="1" Classes="mono-counter" Text="{Binding MediaPlayback.FormattedTimeRange}"/>
                                </Grid>
                                
                                <Slider x:Name="AudioProgressBar" Grid.Row="2" Minimum="0" Maximum="1000" Value="0" Focusable="False" Height="32" 
                                        ValueChanged="AudioProgressBar_ValueChanged"/>
                                
                                <WrapPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AudioPlayButton" Classes="transport-btn" Content="{Binding MediaPlayback.PlayPauseButtonText}" Command="{Binding AudioPlayPauseCommand}" Margin="0,0,8,4"/>
                                    <Button x:Name="AudioStopButton" Classes="transport-btn" Content="Stop" Command="{Binding AudioStopCommand}" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="AudioloopButton" Content="Loop" IsChecked="{Binding MediaPlayback.IsLooping, Mode=TwoWay}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center" Margin="0,0,16,4"/>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="Vol" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                        <Slider x:Name="AudioVolumeBar" Minimum="0" Maximum="10" Value="8" Width="80" Focusable="False" VerticalAlignment="Center" ValueChanged="AudioVolumeBar_ValueChanged"/>
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Top Overlay Bar: Cache Badge (left) + Model Controls (right) in non-overlapping 2-column Grid -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="10" VerticalAlignment="Top">
                            <Border Grid.Column="0"
                                    x:Name="PreviewCacheBadgeBorder"
                                    Background="#C0111111"
                                    BorderBrush="#44ffffff"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding PreviewSession.IsCacheBadgeVisible}">
                                <TextBlock x:Name="PreviewCacheBadgeText"
                                           Foreground="#E6FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding PreviewSession.CacheBadgeText}" />
                            </Border>

                            <!-- Model Controls Panel -->
                            <Border Grid.Column="1"
                                    x:Name="MeshViewerControlsPanel"
                                    Background="#B0111111"
                                    BorderBrush="#33ffffff"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="8"
                                    MinWidth="190"
                                    MaxWidth="260"
                                    ClipToBounds="False"
                                    IsVisible="{Binding #GLPreviewControl.IsVisible}">
                                <StackPanel Spacing="8" MinWidth="174" MaxWidth="244" ClipToBounds="False">
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,0">
                                        <TextBlock Text="Model Controls" VerticalAlignment="Center" Foreground="#AAA" FontWeight="Bold" FontSize="11" />
                                        <Button Grid.Column="1" x:Name="ToggleMeshControlsBtn" Content="{Binding MeshPreview.ControlsToggleGlyph}" Width="24" Height="24" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="Transparent" Foreground="White" BorderBrush="Transparent" Command="{Binding ToggleMeshControlsCommand}" />
                                    </Grid>

                                    <ScrollViewer MaxHeight="520"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsVisible="{Binding MeshPreview.IsControlsExpanded}">
                                    <StackPanel x:Name="MeshViewerControlsContent" Spacing="8" ClipToBounds="False">
                                        <!-- Reset View & 1-Click Model Export -->
                                        <Button x:Name="ResetViewBtn" Content="Reset View" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ResetMeshViewCommand}" Height="28" FontSize="11" />
                                        <Button x:Name="ExportPreviewModelBtn" Content="Export Model..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ExportPreviewModelCommand}" IsVisible="{Binding CanExportPreviewModel}" IsEnabled="{Binding CanStartPreviewModelExport}" Height="28" FontSize="11" ToolTip.Tip="Export the currently previewed 3D model (.glb / .gltf / .fbx)" />
                                        <Button x:Name="BatchExportAnimationsBtn" Content="Batch Export Animations..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding BatchExportPreviewAnimationsCommand}" IsVisible="{Binding CanExportPreviewModel}" IsEnabled="{Binding CanStartPreviewModelExport}" Height="28" FontSize="11" ToolTip.Tip="Select and export multiple compatible AnimationClips with this 3D model (.glb / .gltf / .fbx)" />
                                        <StackPanel x:Name="PreviewExportProgressPanel" Spacing="3" IsVisible="{Binding Export.IsExporting}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <TextBlock x:Name="PreviewExportStatusText" Text="{Binding Export.StatusText}" Foreground="#DDD" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="PreviewExportPercentText" Grid.Column="1" Text="{Binding Export.FormattedPercentText}" Foreground="#AAA" FontSize="10" FontFamily="Monospace" />
                                            </Grid>
                                            <ProgressBar x:Name="PreviewExportProgressBar" Minimum="0" Maximum="100" Value="{Binding Export.ProgressPercent}" Height="5" />
                                        </StackPanel>

                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Text="View" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" x:Name="PreviewViewPresetSelector" MinHeight="28" SelectionChanged="PreviewViewPresetSelector_SelectionChanged" />
                                        </Grid>

                                        <!-- Directional Rotation Buttons -->
                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                            <Button Grid.Column="0" x:Name="RotateLeftBtn" Content="◀" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RotateMeshLeftCommand}" Height="26" FontSize="10" ToolTip.Tip="Rotate Left 90°" />
                                            <Button Grid.Column="1" x:Name="RotateRightBtn" Content="▶" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RotateMeshRightCommand}" Height="26" FontSize="10" ToolTip.Tip="Rotate Right 90°" />
                                            <Button Grid.Column="2" x:Name="RotateUpBtn" Content="▲" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RotateMeshUpCommand}" Height="26" FontSize="10" ToolTip.Tip="Rotate Up 90°" />
                                            <Button Grid.Column="3" x:Name="RotateDownBtn" Content="▼" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RotateMeshDownCommand}" Height="26" FontSize="10" ToolTip.Tip="Rotate Down 90°" />
                                        </Grid>

                                        <!-- Unified 3D Display Controls (Mesh, Avatar & AnimationClip) -->
                                        <StackPanel x:Name="PreviewDisplayControlsContainer" Spacing="6" IsVisible="{Binding MeshPreview.IsGeometryControlsVisible}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="Display" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" x:Name="PreviewRenderModeSelector" MinHeight="28" SelectionChanged="PreviewRenderModeSelector_SelectionChanged" />
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="2">
                                                <CheckBox Grid.Row="0" Grid.Column="0"
                                                          x:Name="ShowMeshCheckBox"
                                                          Content="Mesh"
                                                          Foreground="White"
                                                          FontSize="10"
                                                          MinHeight="24"
                                                          IsChecked="{Binding MeshPreview.ShowMesh, Mode=TwoWay}"
                                                          ToolTip.Tip="Show or hide the 3D mesh surface" />
                                                <CheckBox Grid.Row="0" Grid.Column="1"
                                                          x:Name="UseTexturesCheckBox"
                                                          Content="Textures"
                                                          Foreground="White"
                                                          FontSize="10"
                                                          MinHeight="24"
                                                          IsEnabled="{Binding MeshPreview.ShowMesh}"
                                                          IsChecked="{Binding MeshPreview.UseTextures, Mode=TwoWay}"
                                                          ToolTip.Tip="Toggle material textures (Ctrl+S)" />
                                                <CheckBox Grid.Row="1" Grid.Column="0"
                                                          x:Name="ShowBonesCheckBox"
                                                          Content="Bones"
                                                          Foreground="White"
                                                          FontSize="10"
                                                          MinHeight="24"
                                                          IsVisible="{Binding MeshPreview.IsBoneControlsVisible}"
                                                          IsChecked="{Binding MeshPreview.ShowSkeleton, Mode=TwoWay}"
                                                          ToolTip.Tip="Show or hide skeleton bones (Ctrl+B)" />
                                                <CheckBox Grid.Row="1" Grid.Column="1"
                                                          x:Name="BonesXRayCheckBox"
                                                          Content="X-Ray"
                                                          Foreground="White"
                                                          FontSize="10"
                                                          MinHeight="24"
                                                          IsVisible="{Binding MeshPreview.IsBoneControlsVisible}"
                                                          IsEnabled="{Binding MeshPreview.ShowSkeleton}"
                                                          IsChecked="{Binding MeshPreview.SkeletonXRay, Mode=TwoWay}"
                                                          ToolTip.Tip="Render bones on top of the solid model" />
                                            </Grid>

                                            <CheckBox x:Name="ShowFullModelGroupCheckBox"
                                                      Content="{Binding MeshPreview.FullModelGroupToggleLabel}"
                                                      Foreground="White"
                                                      FontSize="10"
                                                      MinHeight="24"
                                                      IsVisible="{Binding MeshPreview.HasMultiPartModelGroup}"
                                                      IsChecked="{Binding MeshPreview.ShowFullModelGroup, Mode=TwoWay}"
                                                      ToolTip.Tip="Toggle between full multi-part object and single mesh" />
                                        </StackPanel>

                                        <StackPanel x:Name="PreviewCandidateControlsContainer" Spacing="6" IsVisible="{Binding PreviewSession.HasCandidates}">
                                            <TextBlock x:Name="PreviewCandidateLabel" Text="{Binding PreviewSession.CandidateSelectorLabel}" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                            <ComboBox x:Name="PreviewCandidateSelector" MinHeight="28" MaxDropDownHeight="240" SelectionChanged="PreviewCandidateSelector_SelectionChanged" />
                                        </StackPanel>

                                        <!-- Preview Geometry Controls -->
                                        <StackPanel x:Name="BoneSizeContainer" Spacing="6" IsVisible="{Binding MeshPreview.IsGeometryControlsVisible}">
                                            <StackPanel x:Name="BoneSizeControls" Spacing="6" IsVisible="{Binding MeshPreview.IsBoneSizeVisible}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Bone Size" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="BoneSizeLabel" Grid.Column="1" Text="{Binding MeshPreview.FormattedBoneScaleText}" Foreground="#AAA" FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider x:Name="BoneSizeSlider" Minimum="0.1" Maximum="5.0" Value="{Binding MeshPreview.BoneScale, Mode=TwoWay}" Focusable="False" Height="28" Margin="8,0" ClipToBounds="False" ValueChanged="BoneSizeSlider_ValueChanged" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                <TextBlock Text="Mesh Vertices" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AvatarMeshDensityLabel" Grid.Column="1" Text="{Binding MeshPreview.FormattedMeshDensityText}" Foreground="#AAA" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="AvatarMeshDensitySlider" Minimum="1" Maximum="100" Value="{Binding MeshPreview.MeshDensityPercent, Mode=TwoWay}" TickFrequency="1" Focusable="False" Height="28" Margin="8,0" ClipToBounds="False" ValueChanged="AvatarMeshDensitySlider_ValueChanged" />
                                        </StackPanel>

                                        <StackPanel x:Name="MeshMaterialControlsContainer" Spacing="6" IsVisible="{Binding MeshPreview.HasMaterialSlots}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Material" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <Button x:Name="MeshMaterialResetColorButton" Content="Reset Color" MinWidth="82" Height="24" Padding="8,2" FontSize="10" HorizontalContentAlignment="Center" Command="{Binding ResetMeshMaterialColorCommand}" />
                                            </Grid>
                                            <ComboBox x:Name="MeshMaterialSelector" MinHeight="28" MaxDropDownHeight="240" SelectionChanged="MeshMaterialSelector_SelectionChanged" />
                                            <Border x:Name="MeshMaterialColorSwatch" Height="16" CornerRadius="3" BorderBrush="#66ffffff" BorderThickness="1" />

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Alpha" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock x:Name="MeshMaterialAlphaLabel" Grid.Column="1" Text="100%" Foreground="#AAA" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="MeshMaterialAlphaSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" Focusable="False" Height="28" Margin="8,0" ClipToBounds="False" ValueChanged="MeshMaterialSlider_ValueChanged" />

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Red" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock x:Name="MeshMaterialRedLabel" Grid.Column="1" Text="100%" Foreground="#AAA" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="MeshMaterialRedSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" Focusable="False" Height="28" Margin="8,0" ClipToBounds="False" ValueChanged="MeshMaterialSlider_ValueChanged" />

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Green" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock x:Name="MeshMaterialGreenLabel" Grid.Column="1" Text="100%" Foreground="#AAA" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="MeshMaterialGreenSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" Focusable="False" Height="28" Margin="8,0" ClipToBounds="False" ValueChanged="MeshMaterialSlider_ValueChanged" />

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Blue" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock x:Name="MeshMaterialBlueLabel" Grid.Column="1" Text="100%" Foreground="#AAA" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="MeshMaterialBlueSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" Focusable="False" Height="28" Margin="8,0" ClipToBounds="False" ValueChanged="MeshMaterialSlider_ValueChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </Panel>
                    </Grid>
                    <TextBox x:Name="DumpTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             FontFamily="Monospace"
                             IsVisible="{Binding PreviewSession.IsDumpTabActive}"
                             Text="{Binding PreviewSession.DumpTextContent, Mode=OneWay}" />
                    <Border x:Name="ReferencesTabContent"
                            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                            IsVisible="{Binding PreviewSession.IsReferencesTabActive}">
                        <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Name="ReferencesTargetTitleText"
                                                   Text="{Binding PreviewSession.ReferencesTargetTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ReferencesSummaryText"
                                                   Text="{Binding PreviewSession.ReferencesHeaderSummary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Name="GoToSelectedReferenceBtn"
                                            Grid.Column="1"
                                            Content="Go to Asset"
                                            Height="28"
                                            Padding="10,4"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Command="{Binding NavigateToSelectedReferenceCommand}"
                                            ToolTip.Tip="Jump to the selected referenced asset in Asset List and preview it" />
                                </Grid>
                            </Border>

                            <TextBox x:Name="ReferencesFilterTextBox"
                                     Grid.Row="1"
                                     PlaceholderText="Filter references by name, type, relation, or PathID..."
                                     Text="{Binding PreviewSession.ReferencesFilterText, Mode=TwoWay}" />

                            <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto,*" RowSpacing="6">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding PreviewSession.ReferencedBySectionHeader}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="2,0" />
                                <Border Grid.Row="1"
                                        BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ListBox x:Name="ReferencedByListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding PreviewSession.FilteredReferencedByItems}"
                                             SelectedItem="{Binding PreviewSession.SelectedReferenceItem, Mode=TwoWay}"
                                             DoubleTapped="ReferencesListBox_DoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="svc:AssetReferenceItem" x:CompileBindings="True">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,2">
                                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, Mode=OneTime}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailLine, Mode=OneTime}" FontSize="11" Opacity="0.78" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Go"
                                                            Height="24"
                                                            MinWidth="44"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            IsEnabled="{Binding IsNavigable, Mode=OneTime}"
                                                            Command="{Binding $parent[local:MainWindow].ViewModel.NavigateToReferencedAssetCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding PreviewSession.ReferencesSectionHeader}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="2,4,2,0" />
                                <Border Grid.Row="3"
                                        BorderBrush="{DynamicResource SystemControlBorderBackgroundBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ListBox x:Name="ReferencesListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding PreviewSession.FilteredReferencesItems}"
                                             SelectedItem="{Binding PreviewSession.SelectedReferenceItem, Mode=TwoWay}"
                                             DoubleTapped="ReferencesListBox_DoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="svc:AssetReferenceItem" x:CompileBindings="True">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,2">
                                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, Mode=OneTime}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailLine, Mode=OneTime}" FontSize="11" Opacity="0.78" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Go"
                                                            Height="24"
                                                            MinWidth="44"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            IsEnabled="{Binding IsNavigable, Mode=OneTime}"
                                                            Command="{Binding $parent[local:MainWindow].ViewModel.NavigateToReferencedAssetCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Integrated Script Viewer (Mono / IL2CPP / TypeTree / Ghidra Export) -->
                    <Border x:Name="ScriptTabContent"
                            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                            IsVisible="{Binding PreviewSession.IsScriptTabActive}">
                        <Border.Resources>
                            <local:BoolToTextWrappingConverter x:Key="ScriptWordWrapConverter" />
                        </Border.Resources>
                        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="8" RowSpacing="8">
                            <Border Grid.Row="0" Classes="inspector-card">
                                <StackPanel Spacing="6">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock x:Name="ScriptTitleText"
                                                       Grid.Column="0"
                                                       Text="{Binding PreviewSession.ScriptTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Classes="badge-chip"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding PreviewSession.HasScriptBackendBadge}">
                                                <TextBlock x:Name="ScriptBackendBadgeText"
                                                           Text="{Binding PreviewSession.ScriptBackendBadge}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="ScriptSummaryText"
                                                   Text="{Binding PreviewSession.ScriptSummaryText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ScriptCopyButton"
                                                Classes="toolbar-btn"
                                                Content="Copy C#"
                                                Margin="0,0,4,4"
                                                Command="{Binding CopyScriptCodeCommand}"
                                                ToolTip.Tip="Copy full reconstructed C# source code to clipboard" />
                                        <Button x:Name="ScriptSaveButton"
                                                Classes="toolbar-btn"
                                                Content="Save .cs"
                                                Margin="0,0,4,4"
                                                Command="{Binding SaveScriptCodeCommand}"
                                                ToolTip.Tip="Save the reconstructed C# class to a .cs file" />
                                        <Button x:Name="ScriptExportGhidraButton"
                                                Classes="toolbar-btn"
                                                Content="Export Ghidra..."
                                                Margin="0,0,4,4"
                                                Command="{Binding ExportGhidraScriptCommand}"
                                                ToolTip.Tip="Export symbols JSON and a ready-to-run Python apply script for Ghidra" />
                                        <Button x:Name="ScriptSelectFolderButton"
                                                Classes="toolbar-btn"
                                                Content="Scripts Folder..."
                                                Margin="0,0,0,4"
                                                Command="{Binding SelectScriptsFolderCommand}"
                                                ToolTip.Tip="Override auto-discovery by selecting a custom folder containing script assemblies or IL2CPP dump files" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Classes="inspector-card"
                                    IsVisible="{Binding PreviewSession.HasScriptDiagnostic}">
                                <TextBlock x:Name="ScriptDiagnosticText"
                                           Text="{Binding PreviewSession.ScriptDiagnosticText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppWarningAccentBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="ScriptSearchTextBox"
                                         Grid.Column="0"
                                         PlaceholderText="Search C# code (fields, methods, types, RVAs)..."
                                         Text="{Binding PreviewSession.ScriptSearchText, Mode=TwoWay}" />
                                <CheckBox x:Name="ScriptFilterLinesCheckBox"
                                          Grid.Column="1"
                                          Content="Filter lines"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PreviewSession.IsScriptSearchFilterOnly, Mode=TwoWay}" />
                                <CheckBox x:Name="ScriptWordWrapCheckBox"
                                          Grid.Column="2"
                                          Content="Wrap"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PreviewSession.IsScriptWordWrapEnabled, Mode=TwoWay}"
                                          ToolTip.Tip="Wrap long lines in the C# script viewer" />
                                <Border Grid.Column="3"
                                        Classes="badge-chip"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding PreviewSession.HasScriptSearchMatchSummary}">
                                    <TextBlock x:Name="ScriptSearchMatchSummaryText"
                                               Text="{Binding PreviewSession.ScriptSearchMatchSummary}"
                                               FontSize="11" />
                                </Border>
                            </Grid>

                            <TextBox x:Name="ScriptCodeTextBox"
                                     Grid.Row="3"
                                     AcceptsReturn="True"
                                     TextWrapping="{Binding PreviewSession.IsScriptWordWrapEnabled, Converter={StaticResource ScriptWordWrapConverter}}"
                                     IsReadOnly="True"
                                     FontFamily="{StaticResource AppMonoFontFamily}"
                                     FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Text="{Binding PreviewSession.ScriptSourceCode, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Panel>
            </Grid>

        </Grid>
    </DockPanel>
</Window>
