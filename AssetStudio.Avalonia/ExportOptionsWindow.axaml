<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetStudio.Avalonia.ViewModels"
        x:Class="AssetStudio.Avalonia.ExportOptionsWindow"
        x:CompileBindings="True"
        x:DataType="vm:ExportOptionsViewModel"
        Title="Export options"
        Width="420"
        Height="660"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <ScrollViewer>
        <StackPanel Spacing="10" Margin="14">
            <TextBlock Text="Asset grouping" />
            <ComboBox ItemsSource="{Binding AssetGroupingOptions}"
                      SelectedIndex="{Binding AssetGroupingIndex, Mode=TwoWay}" />

            <CheckBox Content="Convert texture"
                      IsChecked="{Binding ConvertTexture, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Texture format" Width="130" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding TextureFormatOptions}"
                          SelectedIndex="{Binding TextureFormatIndex, Mode=TwoWay}" />
            </StackPanel>

            <CheckBox Content="Convert AudioClip to WAV(PCM)"
                      IsChecked="{Binding ConvertAudio, Mode=TwoWay}" />
            <CheckBox Content="Restore extension name"
                      IsChecked="{Binding RestoreExtensionName, Mode=TwoWay}" />
            <CheckBox Content="Open after export"
                      IsChecked="{Binding OpenAfterExport, Mode=TwoWay}" />

            <Border Height="1" Margin="0,4" Background="Gray" />

            <TextBlock Text="FBX" />
            <CheckBox Content="Export skins"
                      IsChecked="{Binding ExportSkins, Mode=TwoWay}" />
            <CheckBox Content="Export animations"
                      IsChecked="{Binding ExportAnimations, Mode=TwoWay}" />
            <CheckBox Content="Export animations as separate FBX files"
                      IsChecked="{Binding ExportAnimationsSplit, Mode=TwoWay}" />
            <CheckBox Content="Export blend shapes"
                      IsChecked="{Binding ExportBlendShape, Mode=TwoWay}" />
            <CheckBox Content="Cast to bone"
                      IsChecked="{Binding CastToBone, Mode=TwoWay}" />
            <CheckBox Content="Combine meshes into single mesh"
                      IsChecked="{Binding CombineMeshes, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Bone size" Width="130" VerticalAlignment="Center" />
                <TextBox Width="90" Text="{Binding BoneSizeText, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scale factor" Width="130" VerticalAlignment="Center" />
                <TextBox Width="90" Text="{Binding ScaleFactorText, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="FBX version" Width="130" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding FbxVersionOptions}"
                          SelectedIndex="{Binding FbxVersion, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="FBX format" Width="130" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding FbxFormatOptions}"
                          SelectedIndex="{Binding FbxFormat, Mode=TwoWay}" />
            </StackPanel>

            <Border Height="1" Margin="0,4" Background="Gray" />

            <TextBlock Text="Unity Integration" />
            <CheckBox Content="Export Unity humanoid .meta"
                      IsChecked="{Binding ExportUnityMeta, Mode=TwoWay}" />
            <CheckBox Content="Export Unity native .anim clips"
                      IsChecked="{Binding ExportUnityAnimClips, Mode=TwoWay}" />

            <TextBlock Text="{Binding ValidationMessage}"
                       IsVisible="{Binding HasValidationMessage}"
                       Foreground="OrangeRed"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Grid.Column="0"
                        Content="Reset defaults"
                        Command="{Binding ResetDefaultsCommand}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="OK"
                            MinWidth="80"
                            Command="{Binding SaveCommand}" />
                    <Button Content="Cancel"
                            MinWidth="80"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
