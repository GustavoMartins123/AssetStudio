<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>0.17.1</Version>
    <AssemblyVersion>0.17.1</AssemblyVersion>
    <FileVersion>0.17.1</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\Bin\**;**\obj\**;**\Obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\bin\**;**\Bin\**;**\obj\**;**\Obj\**" />
    <EmbeddedResource Remove="**\bin\**;**\Bin\**;**\obj\**;**\Obj\**" />
    <None Remove="**\bin\**;**\Bin\**;**\obj\**;**\Obj\**" />
  </ItemGroup>
</Project>
