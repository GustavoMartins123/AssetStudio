<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.17.1</Version>
    <AssemblyVersion>0.17.1</AssemblyVersion>
    <FileVersion>0.17.1</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">$(RELEASE_VERSION)</ReleaseVersion>
    <_NormalizedReleaseVersion Condition="'$(ReleaseVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(ReleaseVersion)', '^\s*(?:[vV]+(?=[0-9]))?|\s+$', ''))</_NormalizedReleaseVersion>
    <_ReleaseNumericPrefix Condition="'$(_NormalizedReleaseVersion)' != '' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_NormalizedReleaseVersion)', '^[0-9]+'))">$([System.Text.RegularExpressions.Regex]::Replace('$(_NormalizedReleaseVersion)', '^([0-9]+(?:\.[0-9]+){0,3}).*$', '$1'))</_ReleaseNumericPrefix>
    <_ReleaseNumericVersion Condition="'$(_ReleaseNumericPrefix)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_ReleaseNumericPrefix).0.0.0', '^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+).*$', '$1'))</_ReleaseNumericVersion>
    <InformationalVersion Condition="'$(_NormalizedReleaseVersion)' != ''">$(_NormalizedReleaseVersion)</InformationalVersion>
    <AssemblyVersion Condition="'$(_ReleaseNumericVersion)' != ''">$(_ReleaseNumericVersion)</AssemblyVersion>
    <FileVersion Condition="'$(_ReleaseNumericVersion)' != ''">$(_ReleaseNumericVersion)</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\Bin\**;**\obj\**;**\Obj\**</DefaultItemExcludes>
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\bin\**;**\Bin\**;**\obj\**;**\Obj\**" />
    <EmbeddedResource Remove="**\bin\**;**\Bin\**;**\obj\**;**\Obj\**" />
    <None Remove="**\bin\**;**\Bin\**;**\obj\**;**\Obj\**" />
  </ItemGroup>
</Project>
